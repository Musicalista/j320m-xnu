From: Musicalista <musicalista@users.noreply.github.com>
Subject: [PATCH 0006] j320m: SMP Quad-Core Cortex-A7 bring-up for Spreadtrum SC9830A

Implement secondary CPU wake-up for cores 1, 2, and 3 on the Spreadtrum
SC9830A SoC. Secondary cores are released by writing their physical entry point
to CPU_JUMP_PADDR (0x20E00018 + cpu_id * 4), asserting the holding pen bit in
HOLDING_PEN_PADDR (0x20E00014), un-gating power via REG_PMU_APB_PD_CA7_C[cpu]_CFG
(0x402B0008..0x402B0010), and kicking GIC SGI 1.

Signed-off-by: Musicalista <musicalista@users.noreply.github.com>
---
 osfmk/arm/j320m_smp.c | 118 ++++++++++++++++++++++++++++++++++++++++++++++++++
 pexpert/arm/pe_j320m.h |  32 ++++++++++++++
 2 files changed, 150 insertions(+)
 create mode 100644 osfmk/arm/j320m_smp.c

diff --git a/pexpert/arm/pe_j320m.h b/pexpert/arm/pe_j320m.h
--- a/pexpert/arm/pe_j320m.h
+++ b/pexpert/arm/pe_j320m.h
@@ -28,6 +28,21 @@
 #define J320M_GICD_BASE         0x12001000u
 #define J320M_GICC_BASE         0x12002000u
 
+/* Spreadtrum SC9830A SMP Power & Holding Pen Registers */
+#define J320M_AHB_BASE          0x20E00000u
+#define J320M_HOLDING_PEN       (J320M_AHB_BASE + 0x14u)
+#define J320M_CPU_JUMP_BASE     (J320M_AHB_BASE + 0x18u)
+#define J320M_CA7_RST_SET       (J320M_AHB_BASE + 0x200u)
+
+#define J320M_PMU_BASE          0x402B0000u
+#define J320M_PMU_CA7_C1_CFG    (J320M_PMU_BASE + 0x0008u)
+#define J320M_PMU_CA7_C2_CFG    (J320M_PMU_BASE + 0x000Cu)
+#define J320M_PMU_CA7_C3_CFG    (J320M_PMU_BASE + 0x0010u)
+
+#define J320M_PMU_FORCE_SHUTDOWN (1u << 25)
+#define J320M_PMU_AUTO_SHUTDOWN  (1u << 26)
+#define J320M_GICD_SGIR          (J320M_GICD_BASE + 0xF00u)
+
 #endif /* _PEXPERT_ARM_PE_J320M_H_ */
diff --git a/osfmk/arm/j320m_smp.c b/osfmk/arm/j320m_smp.c
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/j320m_smp.c
@@ -0,0 +1,118 @@
+/*
+ * Copyright (c) 2026 Musicalista. All rights reserved.
+ * Darwin/XNU SMP secondary CPU bringup for Samsung Galaxy J3 (2016)
+ * Spreadtrum SC9830A Quad Cortex-A7 platform.
+ */
+
+#include <mach/mach_types.h>
+#include <kern/cpu_data.h>
+#include <kern/kalloc.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm/pe_j320m.h>
+
+extern void start_secondary_cpu(void);
+
+static inline void
+j320m_mmio_write32(vm_offset_t addr, uint32_t val)
+{
+	*(volatile uint32_t *)addr = val;
+	__asm__ volatile("dmb sy" ::: "memory");
+}
+
+static inline uint32_t
+j320m_mmio_read32(vm_offset_t addr)
+{
+	uint32_t val = *(volatile uint32_t *)addr;
+	__asm__ volatile("dmb sy" ::: "memory");
+	return val;
+}
+
+static vm_offset_t
+j320m_pmu_cfg_for_cpu(int cpu_id)
+{
+	switch (cpu_id) {
+	case 1:
+		return J320M_PMU_CA7_C1_CFG;
+	case 2:
+		return J320M_PMU_CA7_C2_CFG;
+	case 3:
+		return J320M_PMU_CA7_C3_CFG;
+	default:
+		return 0;
+	}
+}
+
+/*
+ * j320m_start_cpu:
+ * Boot a secondary Cortex-A7 core (cpu_id 1..3) on SC9830A.
+ */
+kern_return_t
+j320m_start_cpu(int cpu_id)
+{
+	vm_offset_t jump_reg;
+	vm_offset_t pmu_reg;
+	uint32_t val;
+	uint32_t entry_phys;
+	unsigned timeout;
+
+	if (cpu_id < 1 || cpu_id >= 4) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	jump_reg = J320M_CPU_JUMP_BASE + ((uint32_t)cpu_id << 2);
+	pmu_reg = j320m_pmu_cfg_for_cpu(cpu_id);
+	if (!pmu_reg) {
+		return KERN_FAILURE;
+	}
+
+	entry_phys = (uint32_t)kvtophys((vm_offset_t)start_secondary_cpu);
+
+	/* 1. Stage secondary physical entry point */
+	j320m_mmio_write32(jump_reg, entry_phys);
+
+	/* 2. Unmask holding pen bit for target core */
+	val = j320m_mmio_read32(J320M_HOLDING_PEN);
+	val |= (1u << cpu_id);
+	j320m_mmio_write32(J320M_HOLDING_PEN, val);
+
+	/* 3. Power-on the CA7 core in SC9830A PMU */
+	val = j320m_mmio_read32(pmu_reg);
+	val &= ~J320M_PMU_FORCE_SHUTDOWN;
+	val |= J320M_PMU_AUTO_SHUTDOWN;
+	j320m_mmio_write32(pmu_reg, val);
+
+	/* 4. Pulse Software Generated Interrupt (SGI 1) via GICv2 */
+	/* SGI 1 targeted at CPU interface cpu_id: TargetList = (1 << cpu_id) */
+	uint32_t sgir = (1u << (16 + cpu_id)) | 1u;
+	j320m_mmio_write32(J320M_GICD_SGIR, sgir);
+
+	/* 5. Await CPU online acknowledgment */
+	timeout = 200000;
+	while (!CpuDataEntries[cpu_id].cpu_data_vaddr->cpu_running && --timeout) {
+		delay(10);
+	}
+
+	if (timeout == 0) {
+		kprintf("j320m_smp: cpu%d failed to acknowledge online\n", cpu_id);
+		return KERN_FAILURE;
+	}
+
+	kprintf("j320m_smp: cpu%d online and active\n", cpu_id);
+	return KERN_SUCCESS;
+}
+
+void
+j320m_smp_init(void)
+{
+	int cpu;
+	kprintf("j320m_smp: initializing Spreadtrum SC9830A 4-core topology\n");
+	for (cpu = 1; cpu < 4; cpu++) {
+		if (j320m_start_cpu(cpu) != KERN_SUCCESS) {
+			kprintf("j320m_smp: warning: core %d did not start\n", cpu);
+		}
+	}
+}
